# Hackstra — example environment file.
# Copy to ".env" for LOCAL development only:  cp .env.example .env && php artisan key:generate
# NEVER commit a real .env. NEVER use these placeholders in production as-is.
#
# Production requirements (see docs/MODERNIZATION.md):
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://your-real-domain
#   SESSION_SECURE_COOKIE=true
#   Rotate every demo/seeded password before any public deployment.

APP_NAME=Hackstra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hackstra
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel 8 uses MAIL_DRIVER; newer Laravel uses MAIL_MAILER. Both are listed
# so the staged upgrade (docs/MODERNIZATION.md) does not lose mail config.
MAIL_DRIVER=smtp
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
